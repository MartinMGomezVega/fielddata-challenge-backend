ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agrobot
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0

HORIZON_DAYS=7
MAX_FORECAST_AGE_HOURS=24
REARM_MARGIN=0.00

EVAL_INTERVAL_MIN=15
DISPATCH_INTERVAL_S=30
BATCH_SIZE=500
MAX_ATTEMPTS=3
LEASE_DURATION_S=60
DISPATCH_CONCURRENCY=10

HOST=0.0.0.0
PORT=8000
